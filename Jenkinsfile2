pipeline {
  agent any
  tools {
    nodejs 'nodeJS'
  }
  stages {
    stage ('Check Node') {
      steps {
        script {
          echo "Checking node version"
          sh '''
            node -v
            npm -v
            npm ci
          '''
        }
      }
    }
    stage ("Test") {
      steps {
        script {
          sh '''
            node app.js &
            sleep 5
            curl http://localhost:3001/
          '''
        }
      }
    }
    stage ('Deploy') {
      steps {
        script {
          echo "Deploy to be configured..."
        }
      }
    }
  }
}
